if(NOT DEFINED TRANSLATOR OR NOT DEFINED ASSEMBLER OR NOT DEFINED INPUT OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "translator test arguments are incomplete")
endif()
set(TRANSLATED "${OUTPUT}.myvm.asm")
execute_process(COMMAND "${TRANSLATOR}" "${INPUT}" "${TRANSLATED}"
    RESULT_VARIABLE translate_result OUTPUT_VARIABLE translate_stdout ERROR_VARIABLE translate_stderr)
if(NOT translate_result EQUAL 0)
    message(FATAL_ERROR "translator failed (${translate_result}): ${translate_stdout}${translate_stderr}")
endif()
execute_process(COMMAND "${ASSEMBLER}" "${TRANSLATED}" -o "${OUTPUT}"
    RESULT_VARIABLE assemble_result OUTPUT_VARIABLE assemble_stdout ERROR_VARIABLE assemble_stderr)
if(NOT assemble_result EQUAL 0)
    message(FATAL_ERROR "translated MyVM assembly failed (${assemble_result}): ${assemble_stdout}${assemble_stderr}")
endif()
if(NOT EXISTS "${OUTPUT}")
    message(FATAL_ERROR "translated bytecode was not created")
endif()
file(SIZE "${OUTPUT}" output_size)
if(output_size LESS 8)
    message(FATAL_ERROR "translated bytecode is too short: ${output_size}")
endif()
